<?xml version="1.0" encoding="utf-8"?>
<!--
  Asphalt. A slight vertical gradient so the tile has depth next to the others
  on the home screen; dark so the yellow plate is the only bright thing on it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startY="0" android:endY="108">
                <item android:offset="0" android:color="#FF2E3644" />
                <item android:offset="1" android:color="#FF151A23" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
